diff --git a/Source/Windows/Common/CRT/ThreadHeap.c b/Source/Windows/Common/CRT/ThreadHeap.c
new file mode 100644
index 0000000000000000000000000000000000000000..f48488fb14410979c05932a877817df5cf7b662a
--- /dev/null
+++ b/Source/Windows/Common/CRT/ThreadHeap.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: MIT
+// Compile the pinned allocator in this translation unit to access its thread
+// heap without changing the submodule or enabling first-class heap semantics.
+#include "rpmalloc/rpmalloc.c"
+#include "ThreadHeap.h"
+
+void* fex_rpmalloc_thread_heap(void) {
+  heap_t* heap = get_thread_heap();
+  return heap != global_heap_default ? heap : 0;
+}
+
+void fex_rpmalloc_retire_thread_heap(void** owner) {
+  heap_t* heap = *owner;
+  *owner = 0;
+  if (!heap) {
+    return;
+  }
+  // Self exit must detach TLS before publishing the heap for reuse. External
+  // exit leaves the caller's TLS alone; the quiescent target cannot use its TLS.
+  if (heap == get_thread_heap()) {
+    set_thread_heap(global_heap_default);
+  }
+  // Like rpmalloc_thread_finalize: queue the heap without freeing live blocks
+  // or changing owner_thread, so cross-thread frees still use deferred lists.
+  heap_release(heap);
+}
diff --git a/Source/Windows/Common/CRT/ThreadHeap.h b/Source/Windows/Common/CRT/ThreadHeap.h
new file mode 100644
index 0000000000000000000000000000000000000000..d45cd502d10c570a1099259e127ff8af202bbf4a
--- /dev/null
+++ b/Source/Windows/Common/CRT/ThreadHeap.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void* fex_rpmalloc_thread_heap(void);
+
+// The owner slot must be exclusively held, and the target must never allocate
+// again. Release only after destroying its thread state. Live blocks survive.
+// Consumes the slot; repeated retirement of the consumed slot is a no-op.
+void fex_rpmalloc_retire_thread_heap(void** owner);
+
+#ifdef __cplusplus
+}
+#endif
