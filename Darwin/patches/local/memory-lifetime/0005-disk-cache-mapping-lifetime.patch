diff --git a/Source/Windows/Common/FEXUnixLib.cpp b/Source/Windows/Common/FEXUnixLib.cpp
index 0b59dd5651381c90e5795a9748f2785639933082..5e9f2c939fdec67ed935a627cdcfd2a21ce22f6f 100644
--- a/Source/Windows/Common/FEXUnixLib.cpp
+++ b/Source/Windows/Common/FEXUnixLib.cpp
@@ -215,6 +215,12 @@ void* MapFile(HANDLE FileHandle, uint64_t MapSize) {
   return nullptr;
 }
 
+void UnmapFile(void* Mapping, uint64_t MapSize) {
+  FEXUnixLib_UnmapFile Args {Mapping, MapSize};
+  const auto Status = Call(FEXUnixLibFunctions::UnmapFile, &Args);
+  LOGMAN_THROW_A_FMT(Status == STATUS_SUCCESS, "Failed to unmap disk cache file: {:#x}", static_cast<uint32_t>(Status));
+}
+
 uint32_t GetPID() {
   if (Available()) {
     FEXUnixLib_GetPID Args {};
diff --git a/Source/Windows/Common/FEXUnixLib.h b/Source/Windows/Common/FEXUnixLib.h
