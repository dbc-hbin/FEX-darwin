@@ -166,6 +167,13 @@ namespace DiskCache {
 
   class IndexedDB {
   public:
+    IndexedDB() = default;
+    ~IndexedDB();
+    IndexedDB(const IndexedDB&) = delete;
+    IndexedDB& operator=(const IndexedDB&) = delete;
+    IndexedDB(IndexedDB&&) = delete;
+    IndexedDB& operator=(IndexedDB&&) = delete;
+
     bool Open(const fextl::string& CacheDBName, bool ReadOnly);
     void PopulateIndex(Index& CacheIndex, bool& FoundMetadata);
     bool ReadCacheBlob(uint64_t Offset, std::span<uint8_t> OutBlob);
@@ -183,6 +191,7 @@ namespace DiskCache {
     FOZFile CacheFOZ;
     uint8_t* CacheFileMapping = nullptr;
     uint64_t CacheFileMappingSize = 0;
+    FileUnmapperFunc CacheFileUnmapper = nullptr;
     std::atomic<uint64_t> CacheFileSize {};
     FOZFile IndexFOZ;
     bool ReadOnly = false;
diff --git a/FEXCore/include/FEXCore/Core/DiskCacheFileMapper.h b/FEXCore/include/FEXCore/Core/DiskCacheFileMapper.h
index 6e32c07bfc7dc6b96123a259f1a7e75cb2453cdd..64ee4ad1c6733038d5d83b9cdf7abb8194c095b6 100644
--- a/FEXCore/include/FEXCore/Core/DiskCacheFileMapper.h
+++ b/FEXCore/include/FEXCore/Core/DiskCacheFileMapper.h
@@ -6,6 +6,8 @@
 
 namespace FEXCore::DiskCache {
 using FileMapperFunc = void* (*)(FEXCore::File::File::FileHandleType Handle, uint64_t MapSize);
+using FileUnmapperFunc = void (*)(void* Mapping, uint64_t MapSize);
 
-FEX_DEFAULT_VISIBILITY void SetFileMapper(FileMapperFunc Func);
+// Successful mappings are owned by the database and released with the same size.
+FEX_DEFAULT_VISIBILITY void SetFileMapper(FileMapperFunc Mapper, FileUnmapperFunc Unmapper);
 } // namespace FEXCore::DiskCache
diff --git a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
index 73b0bb92202755444702bc2459f3925317a410fc..024c6475101af85f87a80ff29844de41ee937ee9 100644
--- a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
+++ b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
@@ -203,6 +203,10 @@ static void* DiskCacheFilemapper(FEXCore::File::File::FileHandleType Handle, uin
   return Result;
 }
 
+static void DiskCacheFileUnmapper(void* Mapping, uint64_t MapSize) {
+  FEXCore::Allocator::munmap(Mapping, MapSize);
+}
+
 bool InterpreterHandler(fextl::string* Filename, const fextl::string& RootFS, fextl::vector<fextl::string>* args) {
   int FD {-1};
 
@@ -539,7 +543,7 @@ int main(int argc, char** argv, char** const envp) {
   // Setup Thread handlers, so FEXCore can create threads.
   auto StackTracker = FEX::LinuxEmulation::Threads::SetupThreadHandlers();
 
-  FEXCore::DiskCache::SetFileMapper(DiskCacheFilemapper);
+  FEXCore::DiskCache::SetFileMapper(DiskCacheFilemapper, DiskCacheFileUnmapper);
 
   auto MemoryRegions = FEX::Allocator::InitMemoryRegions(Loader.Is64BitMode());
   auto Allocator = FEX::Allocator::InitAllocator(Loader.Is64BitMode());
