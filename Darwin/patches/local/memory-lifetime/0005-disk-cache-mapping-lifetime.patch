Subject: [PATCH] disk cache mapping lifetime

Release native cache mappings with the database that owns them.

Source: local macOS Wine queue; see ../../README.md for ancestry and dependencies.
License: ../LICENSE (MIT)

diff --git a/FEXCore/Source/Interface/Core/DiskCache.cpp b/FEXCore/Source/Interface/Core/DiskCache.cpp
index be1584ea838cf421b3d2f852f3fdaa2129c25a93..0706cc0bca78e3d89823f395098edb6326543a55 100644
--- a/FEXCore/Source/Interface/Core/DiskCache.cpp
+++ b/FEXCore/Source/Interface/Core/DiskCache.cpp
@@ -59,6 +59,7 @@ namespace DiskCache {
   };
 
   static FileMapperFunc FileMapper = nullptr;
+  static FileUnmapperFunc FileUnmapper = nullptr;
 
   bool FOZFile::Open(const fextl::string& FOZFileName, bool ReadOnly) {
     FileName = FOZFileName;
@@ -171,6 +172,12 @@ namespace DiskCache {
     return true;
   }
 
+  IndexedDB::~IndexedDB() {
+    if (CacheFileMapping) {
+      CacheFileUnmapper(CacheFileMapping, CacheFileMappingSize);
+    }
+  }
+
   bool IndexedDB::Open(const fextl::string& CacheDBName, bool ReadOnly) {
     if (!CacheFOZ.Open(CacheDBName + ".foz", ReadOnly)) {
       return false;
@@ -183,9 +190,10 @@ namespace DiskCache {
     const ssize_t FileSize = CacheFOZ.Size();
     if (MapDiskCacheFiles && FileSize > 0 && CacheFileHandle != (File::File::FileHandleType)-1) {
       CacheFileSize = FileSize;
-      if (FileMapper) {
+      if (FileMapper && FileUnmapper) {
         CacheFileMappingSize = ReadOnly ? FileSize : BIG_MAPPING_SIZE;
         CacheFileMapping = reinterpret_cast<uint8_t*>(FileMapper(CacheFileHandle, CacheFileMappingSize));
+        CacheFileUnmapper = FileUnmapper;
       }
     }
 
@@ -385,8 +393,9 @@ namespace DiskCache {
     return true;
   }
 
-  FEX_DEFAULT_VISIBILITY void SetFileMapper(FileMapperFunc Func) {
-    FileMapper = Func;
+  FEX_DEFAULT_VISIBILITY void SetFileMapper(FileMapperFunc Mapper, FileUnmapperFunc Unmapper) {
+    FileMapper = Mapper;
+    FileUnmapper = Unmapper;
   }
 
   static inline void PruneStaleEntries(std::string_view CacheBase, std::string_view MachineBucketHash) {
