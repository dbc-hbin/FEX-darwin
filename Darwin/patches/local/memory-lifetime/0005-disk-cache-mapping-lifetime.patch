 void DeleteSHMStatsFile();
 
 void* MapFile(HANDLE FileHandle, uint64_t MapSize);
+void UnmapFile(void* Mapping, uint64_t MapSize);
 
 // Returns the process pid when unixlib is available.
 // Or returns the process ID otherwise.
diff --git a/Source/Windows/UnixLib/FEXUnixLib.cpp b/Source/Windows/UnixLib/FEXUnixLib.cpp
index 8637e71df837daa51ddf202333fa7565ca4ef856..95223e00b88c2474d2815f0b2aeb32567a6ef2cb 100644
--- a/Source/Windows/UnixLib/FEXUnixLib.cpp
+++ b/Source/Windows/UnixLib/FEXUnixLib.cpp
@@ -213,6 +213,11 @@ static NTSTATUS FEXUnixLib_MapFileHandler(void* _Args) {
   return STATUS_SUCCESS;
 }
 
+static NTSTATUS FEXUnixLib_UnmapFileHandler(void* _Args) {
+  auto Args = reinterpret_cast<const FEXUnixLib_UnmapFile*>(_Args);
+  return munmap(Args->Mapping, Args->MapSize) == 0 ? STATUS_SUCCESS : STATUS_INTERNAL_ERROR;
+}
+
 static NTSTATUS FEXUnixLib_GetPIDHandler(void* _Args) {
   auto Args = reinterpret_cast<FEXUnixLib_GetPID*>(_Args);
   Args->Result = ::getpid();
@@ -294,6 +299,7 @@ extern "C" const unixlib_entry_t __wine_unix_call_funcs[] = {
   FEXUnixLib_GetPIDHandler,
   FEXUnixLib_CheckSupportsTPIDRRO_CPUHandler,
   FEXUnixLib_JITWriteProtectHandler,
+  FEXUnixLib_UnmapFileHandler,
 };
 
 static_assert(sizeof(__wine_unix_call_funcs) / sizeof(__wine_unix_call_funcs[0]) == ToUnderlying(FEXUnixLibFunctions::MAX));
diff --git a/Source/Windows/UnixLib/FEXUnixLib.h b/Source/Windows/UnixLib/FEXUnixLib.h
