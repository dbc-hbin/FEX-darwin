From: Local Wine build maintainers
Subject: [PATCH] Windows: enable cache, hidden hypervisor and hardware TSO defaults
Source: Locally authored for this repository; not an upstream/Hadron patch.

Enable the disk cache and hidden hypervisor bit in this Windows-only port.
Probe hardware TSO when HADRON_HARDWARE_TSO is unset, retaining explicit
opt-out and the successful kernel-call requirement. FEX_TSOENABLED already
defaults to true; its override and software fallback remain unchanged.

diff --git a/FEXCore/Source/Interface/Config/Config.json.in b/FEXCore/Source/Interface/Config/Config.json.in
--- a/FEXCore/Source/Interface/Config/Config.json.in
+++ b/FEXCore/Source/Interface/Config/Config.json.in
@@ -160,7 +160,7 @@
       },
       "DiskCache": {
         "Type": "bool",
-        "Default": "false",
+        "Default": "true",
         "AffectsCodeGen": "false",
         "Desc": [
           "Enables disk caching for code blocks"
@@ -654,7 +654,7 @@
       },
       "HideHypervisorBit": {
         "Type": "bool",
-        "Default": "false",
+        "Default": "true",
         "AffectsCodeGen": "false",
         "Desc": [
           "Hides the hypervisor CPUID bit when set.",
diff --git a/Source/Windows/UnixLib/FEXUnixLib.cpp b/Source/Windows/UnixLib/FEXUnixLib.cpp
--- a/Source/Windows/UnixLib/FEXUnixLib.cpp
+++ b/Source/Windows/UnixLib/FEXUnixLib.cpp
@@ -73,7 +73,7 @@
 static NTSTATUS FEXUnixLib_SetHardwareTSOControlHandler(void* _Args) {
   auto Args = reinterpret_cast<const FEXUnixLib_SetHardwareTSOControlArgs*>(_Args);
   const char* Env = getenv("HADRON_HARDWARE_TSO");
-  if (!thread_set_x86_64_compat || !Env || strcmp(Env, "1")) {  // opt-in, see Wine's enable_hardware_tso
+  if (!thread_set_x86_64_compat || (Env && strcmp(Env, "1"))) {  // opt-out, see Wine's enable_hardware_tso
     return STATUS_NOT_SUPPORTED;
   }
   return thread_set_x86_64_compat(Args->Enable) == KERN_SUCCESS ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
