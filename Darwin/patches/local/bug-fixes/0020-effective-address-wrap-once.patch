+                           .Index = Src.Ref(),
+                           .AddrSize = DestAddress.AddrSize};
 
     switch (Action) {
     case BTAction::BTNone: {
diff --git a/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm b/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm
new file mode 100644
index 000000000..272dbfcb5
--- /dev/null
+++ b/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm
@@ -0,0 +1,130 @@
+%ifdef CONFIG
+{
+  "RegData": {
+    "RAX": "0x2",
+    "RBX": "0x17D992",
+    "RCX": "0x1",
+    "RDX": "0x0",
+    "RBP": "0x64",
+    "RSI": "0xA5A50009",
+    "RDI": "0x5A5A0028"
+  },
+  "MemoryRegions": {
+    "0x10000": "4096",
+    "0x10000000": "4096",
+    "0xffff0000": "4096"
+  },
+  "Mode": "32BIT"
+}
+%endif
+
+; Register bit indices add a signed byte displacement to the effective address
+; before address-size wrapping and segment addition. Immediate indices are masked.
+; An absent offset base must not become an Invalid IR value in arithmetic.
+mov dword [0x10000000], 2
+mov dword [0x10000004], 1
+xor ebx, ebx
+
+bt dword [0x10000000], 1
+adc ebx, ebx
+bts dword [0x10000000], 3
+adc ebx, ebx
+btr dword [0x10000000], 1
+adc ebx, ebx
+btc dword [0x10000000], 3
+adc ebx, ebx
+mov edx, [0x10000000]
+
+mov esi, 32
+bt dword [0x10000000], esi
+adc ebx, ebx
+mov dword [0x10000000], 2
+mov esi, -31
+bt dword [0x10000004], esi
+adc ebx, ebx
+bt word [0x10000000], 1
+adc ebx, ebx
+
+; Dynamic byte offsets must reach both scalar TSO loads and stores.
+mov dword [0x10000008], 0
+mov esi, 64
+bts dword [0x10000000], esi
+adc ebx, ebx
+bt dword [0x10000000], esi
+adc ebx, ebx
+btc dword [0x10000000], esi
+adc ebx, ebx
+btr dword [0x10000000], esi
+adc ebx, ebx
+mov esi, -64
+bts dword [0x10000010], esi
+adc ebx, ebx
+bt dword [0x10000010], esi
+adc ebx, ebx
+btr dword [0x10000010], esi
+adc ebx, ebx
+btc dword [0x10000010], esi
+adc ebx, ebx
+
+; Locked updates use the same signed byte displacement.
+mov dword [0x10000008], 0
+mov esi, 64
+lock bts dword [0x10000000], esi
+adc ebx, ebx
+lock btc dword [0x10000000], esi
+adc ebx, ebx
+lock btr dword [0x10000000], esi
+adc ebx, ebx
+mov esi, -64
+lock bts dword [0x10000010], esi
+adc ebx, ebx
+lock btr dword [0x10000010], esi
+adc ebx, ebx
+lock btc dword [0x10000010], esi
+adc ebx, ebx
+
+; Keep each update's bit distinct so final memory proves every wrapped write.
+mov dword [0x10000], 0xA5A50002
+mov dword [0xffff0000], 0x5A5A0004
+xor ebp, ebp
+
+; Unlocked overflow: 0xffff0000 + (0x00100003 >> 3) wraps to 0x10000.
+mov edi, 0xffff0000
+mov ecx, 0x00100003
+bts dword [edi], ecx
+adc ebp, ebp
+bt dword [edi], ecx
+adc ebp, ebp
+
+; Unlocked underflow: 0x10000 + (-0x00100000 >> 3) wraps to 0xffff0000.
+mov edi, 0x10000
+mov ecx, -0x00100000 + 2
+btr dword [edi], ecx
+adc ebp, ebp
+bt dword [edi], ecx
+adc ebp, ebp
+
+; Locked overflow must wrap before the atomic address is materialized.
+mov edi, 0xffff0000
+mov ecx, 0x00100000
+lock bts dword [edi], ecx
+adc ebp, ebp
+mov ecx, 0x00100001
+lock btc dword [edi], ecx
+adc ebp, ebp
+
+; Locked negative indices must wrap underflow through the same address stage.
+mov edi, 0x10000
+mov ecx, -0x00100000 + 5
+lock bts dword [edi], ecx
+adc ebp, ebp
+mov ecx, -0x00100000 + 3
+lock btc dword [edi], ecx
+adc ebp, ebp
+
+; CF sequence is 0,1,1,0,0,1,0,0; full dwords also check untouched bits.
+mov esi, [0x10000]
+mov edi, [0xffff0000]
+mov eax, [0x10000000]
+mov ecx, [0x10000004]
+hlt
