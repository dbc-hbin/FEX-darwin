@@ -1771,6 +1787,28 @@ void Decoder::DecodeLoop(const uint8_t* _InstStream, uint64_t GuestSizePause) {
 
   for (auto& Block : BlockInfo.Blocks) {
     Block.IsEntryPoint = BlockInfo.EntryPoints.contains(Block.Entry);
+    if (CTX->Config.SMCChecks == FEXCore::Config::CONFIG_SMC_FULL || Block.ForceFullSMCDetection) {
+      // A validated instruction must retain the semantics whose bytes were captured.
+      // Relocating its operands from live guest memory could bless a racing write.
+      Block.DataMasks.clear();
+      for (size_t i = 0; i < Block.NumInstructions; ++i) {
+        auto& Inst = Block.DecodedInstructions[i];
+        for (auto* Operand : {&Inst.Dest, &Inst.Src[0], &Inst.Src[1], &Inst.Src[2]}) {
+          if (Operand->IsLiteralPatchable()) {
+            const auto Value = Operand->Data.LiteralPatchable.Value;
+            const auto Size = Operand->Data.LiteralPatchable.Size;
+            Operand->Type = DecodedOperand::OpType::Literal;
+            Operand->Data.Literal = {.Value = Value, .Size = Size};
+          } else if (Operand->IsGPRIndirect()) {
+            Operand->Data.GPRIndirect.PatchableDisp = false;
+          } else if (Operand->IsRIPRelative()) {
+            Operand->Data.RIPLiteral.PatchableDisp = false;
+          } else if (Operand->IsSIB()) {
+            Operand->Data.SIB.PatchableDisp = false;
+          }
+        }
+      }
+    }
   }
 
   // now that multiblock has settled down, remove any branch masks we put down that didn't end the block
