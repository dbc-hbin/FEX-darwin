diff --git a/FEXCore/Source/Utils/crc32.h b/FEXCore/Source/Utils/crc32.h
index f9fc7b1143269723f6d30ff91df087361ebc0773..aa17d64b53b9fc3b94025f81ede922acae51fd79 100644
--- a/FEXCore/Source/Utils/crc32.h
+++ b/FEXCore/Source/Utils/crc32.h
@@ -2,6 +2,7 @@
 #pragma once
 #include <cstddef>
 #include <cstdint>
+#include <cstring>
 #if defined(ARCHITECTURE_arm64)
 #include <arm_acle.h>
 #endif
@@ -11,17 +12,20 @@ template<typename T>
 static inline uint32_t crc32(const T* Ptr, size_t Size) {
   uint32_t Result {};
 #if defined(ARCHITECTURE_arm64)
-#define do_crc(type, suffix)                                               \
-  while (Size >= sizeof(type)) {                                           \
-    Result = __crc32##suffix(Result, *reinterpret_cast<const type*>(Ptr)); \
-    Ptr += sizeof(type);                                                   \
-    Size -= sizeof(type);                                                  \
-  }
-  do_crc(uint64_t, d);
-  do_crc(uint32_t, w);
-  do_crc(uint16_t, h);
-  do_crc(uint8_t, b);
-#undef do_crc
+  const auto* Bytes = reinterpret_cast<const uint8_t*>(Ptr);
+  auto Consume = [&]<typename U>(auto CRC) {
+    while (Size >= sizeof(U)) {
+      U Value;
+      std::memcpy(&Value, Bytes, sizeof(Value));
+      Result = CRC(Result, Value);
+      Bytes += sizeof(U);
+      Size -= sizeof(U);
+    }
+  };
+  Consume.template operator()<uint64_t>([](uint32_t C, uint64_t V) { return __crc32d(C, V); });
+  Consume.template operator()<uint32_t>([](uint32_t C, uint32_t V) { return __crc32w(C, V); });
+  Consume.template operator()<uint16_t>([](uint32_t C, uint16_t V) { return __crc32h(C, V); });
+  Consume.template operator()<uint8_t>([](uint32_t C, uint8_t V) { return __crc32b(C, V); });
 #else
   // Emulate arm64 crc32.
   // This is basically just the pseudo-code for crc32b.
