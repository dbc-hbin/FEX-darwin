       return {};
     }
 
+    if (ehdr.e_shstrndx >= shdrs->size()) {
+      return {};
+    }
     const Elf64_Shdr* StrHeader = &shdrs->at(ehdr.e_shstrndx);
     auto SHStringSection = MapSection(fd, StrHeader->sh_offset, StrHeader->sh_size);
     if (SHStringSection.base == nullptr) {
       return {};
     }
 
-    auto find_name = [&SHStringSection](int offset) -> std::string_view {
-      if (offset >= SHStringSection.size) {
+    auto find_name = [&SHStringSection, StrHeader](uint32_t offset) -> std::string_view {
+      if (offset >= StrHeader->sh_size) {
         return {};
       }
 
-      return reinterpret_cast<const char*>(SHStringSection.ptr) + offset;
+      const auto* Name = reinterpret_cast<const char*>(SHStringSection.ptr) + offset;
+      const auto* End = static_cast<const char*>(memchr(Name, 0, StrHeader->sh_size - offset));
+      return End ? std::string_view(Name, End - Name) : std::string_view {};
     };
 
     fextl::vector<uint8_t> BuildID {};
@@ -363,13 +368,18 @@ struct ELFParser {
         char Name[];
       };
 
-      auto Note = reinterpret_cast<const ELFNote*>(BuildIDSection.ptr);
-      const auto DataOffset = (Note->NameSize + 3) & ~3;
-
-      if (Note->Type == NT_GNU_BUILD_ID && Note->NameSize == 4 && std::string_view(Note->Name, Note->NameSize - 1) == "GNU" &&
-          shdr.sh_size <= (12 + DataOffset + Note->DescSize)) {
-        auto Desc = reinterpret_cast<const uint8_t*>(&Note->Name[0] + DataOffset);
-        BuildID.insert(BuildID.end(), Desc, Desc + Note->DescSize);
+      if (shdr.sh_size >= sizeof(ELFNote)) {
+        ELFNote Note;
+        memcpy(&Note, BuildIDSection.ptr, sizeof(Note));
+        const auto* Name = static_cast<const uint8_t*>(BuildIDSection.ptr) + sizeof(Note);
+        const uint64_t Remaining = shdr.sh_size - sizeof(Note);
+        const uint64_t DataOffset = (uint64_t {Note.NameSize} + 3) & ~uint64_t {3};
+
+        if (Note.Type == NT_GNU_BUILD_ID && Note.NameSize == 4 && DataOffset <= Remaining &&
+            Note.DescSize <= Remaining - DataOffset && memcmp(Name, "GNU", 4) == 0) {
+          const auto* Desc = Name + DataOffset;
+          BuildID.insert(BuildID.end(), Desc, Desc + Note.DescSize);
+        }
       }
 
       FreeSection(BuildIDSection);
