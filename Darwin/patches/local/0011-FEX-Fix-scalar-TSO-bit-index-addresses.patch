diff --git a/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm b/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm
index c623150f113d1d23806ff70703422497ec9de30a..620dbecf3445ef90edeb27af3570d4cb3b06f972 100644
--- a/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm
+++ b/unittests/32Bit_ASM/FEX_bugs/BitTestMemoryAddress.asm
@@ -2,7 +2,7 @@
 {
   "RegData": {
     "RAX": "0x2",
-    "RBX": "0x5F",
+    "RBX": "0x17D992",
     "RCX": "0x1",
     "RDX": "0x0"
   },
@@ -39,6 +39,44 @@ adc ebx, ebx
 bt word [0x10000000], 1
 adc ebx, ebx
 
+; Dynamic byte offsets must reach both scalar TSO loads and stores.
+mov dword [0x10000008], 0
+mov esi, 64
+bts dword [0x10000000], esi
+adc ebx, ebx
+bt dword [0x10000000], esi
+adc ebx, ebx
+btc dword [0x10000000], esi
+adc ebx, ebx
+btr dword [0x10000000], esi
+adc ebx, ebx
+mov esi, -64
+bts dword [0x10000010], esi
+adc ebx, ebx
+bt dword [0x10000010], esi
+adc ebx, ebx
+btr dword [0x10000010], esi
+adc ebx, ebx
+btc dword [0x10000010], esi
+adc ebx, ebx
+
+; Locked updates use the same signed, linear offset.
+mov dword [0x10000008], 0
+mov esi, 64
+lock bts dword [0x10000000], esi
+adc ebx, ebx
+lock btc dword [0x10000000], esi
+adc ebx, ebx
+lock btr dword [0x10000000], esi
+adc ebx, ebx
+mov esi, -64
+lock bts dword [0x10000010], esi
+adc ebx, ebx
+lock btr dword [0x10000010], esi
+adc ebx, ebx
+lock btc dword [0x10000010], esi
+adc ebx, ebx
+
 mov eax, [0x10000000]
 mov ecx, [0x10000004]
 hlt
