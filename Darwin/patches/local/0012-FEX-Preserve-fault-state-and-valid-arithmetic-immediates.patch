diff --git a/FEXCore/Source/Interface/Core/DiskCache.h b/FEXCore/Source/Interface/Core/DiskCache.h
index f5933cf0c..9038868b1 100644
--- a/FEXCore/Source/Interface/Core/DiskCache.h
+++ b/FEXCore/Source/Interface/Core/DiskCache.h
@@ -255,8 +255,8 @@ namespace DiskCache {
 
   static constexpr uint16_t AnonPrefixGuestBytes = 64;
   // Darwin code generation uses a separate cache namespace from upstream.
-  // Shared division remainder lowering and simplified Darwin translation.
-  static constexpr uint16_t FormatVersion = 0xA623;
+  // Preserve committed guest state at faults and valid arithmetic immediates.
+  static constexpr uint16_t FormatVersion = 0xA624;
 
   static constexpr uint32_t LOOKUP_KEY_MAX_BUCKET_DEPTH = 500;
 
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 2c9405b0b..bfde94922 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -5002,7 +5002,7 @@ void OpDispatchBuilder::ALUOp(OpcodeArgs, FEXCore::IR::IROps ALUIROp, FEXCore::I
     Result = _Not(OpSize, Dest);
   } else if (IsConst && Const == Mask && !DestIsLockedMem(Op) && ALUIROp == IR::IROps::OP_AND) {
     Result = Dest;
-  } else {
+  } else if (ALUIROp != IR::IROps::OP_ADD && ALUIROp != IR::IROps::OP_SUB) {
     DeriveOp(ALUOp, ALUIROp, _AndWithFlags(OpSize, Dest, Src));
     Result = ALUOp;
   }
diff --git a/FEXCore/Source/Interface/IR/Passes/RegisterAllocationPass.cpp b/FEXCore/Source/Interface/IR/Passes/RegisterAllocationPass.cpp
index d3fd14220..39b3e6983 100644
--- a/FEXCore/Source/Interface/IR/Passes/RegisterAllocationPass.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/RegisterAllocationPass.cpp
@@ -468,7 +468,10 @@ static bool KillMove(const IROp_Header* LastOp, IROp_Header* IROp, Ref LastNode,
     }
   }
 
-  return LastOp->Op == OP_STOREREGISTER;
+  // A faulting consumer must expose the already committed guest register.
+  // These two memory operations lack HasSideEffects, like the SRA epoch barriers below.
+  return LastOp->Op == OP_STOREREGISTER && !IR::HasSideEffects(IROp->Op) &&
+         IROp->Op != OP_LOADMEMX87SVEOPTPREDICATE && IROp->Op != OP_VBROADCASTFROMMEM;
 }
 
 static bool IsSignext(const IROp_Header* IROp, OrderedNodeWrapper Src, OpSize Size) {
