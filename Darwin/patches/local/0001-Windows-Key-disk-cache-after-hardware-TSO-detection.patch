From: Local Wine build maintainers
Subject: [PATCH] Windows: key disk cache after effective hardware TSO detection
Source: Locally authored for this repository; not an upstream/Hadron patch.

Defer Windows disk-cache initialization until the hardware probe has completed.
Hash effective hardware TSO in the process bucket so both modes can coexist,
and invalidate ambiguous pre-fix caches with a format-version bump. Linux's
constructor-time initialization remains unchanged.

diff --git a/FEXCore/Source/Interface/Context/Context.h b/FEXCore/Source/Interface/Context/Context.h
index 9f427da..2a5130f 100644
--- a/FEXCore/Source/Interface/Context/Context.h
+++ b/FEXCore/Source/Interface/Context/Context.h
@@ -205,7 +205,15 @@ public:
   FEXCore::CPUID::XCRResults RunXCRFunction(uint32_t Function) override;
   FEXCore::CPUID::FunctionResults RunCPUIDFunctionName(uint32_t Function, uint32_t Leaf, uint32_t CPU) override;
 
-  virtual void InitDiskCache() override {}
+  void InitDiskCache() override {
+#ifdef _WIN32
+    // Windows probes hardware TSO after constructing the context, before creating guest threads.
+    if (!DiskCacheInitialized) {
+      DiskCache.Init(this);
+      DiskCacheInitialized = true;
+    }
+#endif
+  }
 
   CodeCache& GetCodeCache() override {
     return CodeCache;
@@ -455,6 +463,10 @@ public:
     UpdateAtomicTSOEmulationConfig();
   }
 
+  bool HasHardwareTSOSupport() const {
+    return SupportsHardwareTSO;
+  }
+
   void EnableExitOnHLT() override {
     ExitOnHLT = true;
   }
@@ -493,6 +505,7 @@ private:
    */
   void InitializeCompiler(FEXCore::Core::InternalThreadState* Thread);
 
+  bool DiskCacheInitialized = false;
   bool SupportsHardwareTSO = false;
   bool AtomicTSOEmulationEnabled = true;
   bool VectorAtomicTSOEmulationEnabled = false;
diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 63280a4..52bd64d 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -113,7 +113,9 @@ ContextImpl::ContextImpl(const FEXCore::HostFeatures& Features)
   HostRNGAvailable = true;
 #endif
 
+#ifndef _WIN32
   DiskCache.Init(this);
+#endif
 }
 
 struct GetFrameBlockInfoResult {
diff --git a/FEXCore/Source/Interface/Core/DiskCache.cpp b/FEXCore/Source/Interface/Core/DiskCache.cpp
index cf34191..3a6ae0a 100644
--- a/FEXCore/Source/Interface/Core/DiskCache.cpp
+++ b/FEXCore/Source/Interface/Core/DiskCache.cpp
@@ -409,17 +409,17 @@ namespace DiskCache {
       uint64_t HostFeaturesHash;
     } MachineBucketData = {FormatVersion, HostFeatureHash.HostFeaturesHash};
 
-    fextl::vector<uint8_t> BucketBytes(sizeof(MachineBucketData) + (sizeof(uint8_t) * 2) + SerializedConfig.size());
+    fextl::vector<uint8_t> BucketBytes(sizeof(MachineBucketData) + (sizeof(uint8_t) * 3) + SerializedConfig.size());
     memcpy(BucketBytes.data(), &MachineBucketData, sizeof(MachineBucketData));
 
-    // 64-bit mode and HostType is in the ProcessBucket hash only instead of the MachineBucketHash
-    // These effect code-gen, but they aren't part of the MachineBucketHash, as it comes from Process state.
+    // Keep process code-generation state out of the machine bucket so alternate modes can coexist.
     BucketBytes[sizeof(MachineBucketData)] = CTX->Config.Is64BitMode;
     BucketBytes[sizeof(MachineBucketData) + 1] = FEXCore::ToUnderlying(HostFeatureHash.HostType);
-    memcpy(BucketBytes.data() + sizeof(MachineBucketData) + 2, SerializedConfig.data(), SerializedConfig.size());
+    BucketBytes[sizeof(MachineBucketData) + 2] = CTX->HasHardwareTSOSupport();
+    memcpy(BucketBytes.data() + sizeof(MachineBucketData) + 3, SerializedConfig.data(), SerializedConfig.size());
 
     uint64_t MachineBucketHash = XXH3_64bits(BucketBytes.data(), sizeof(MachineBucketData));
-    uint64_t ProcessBucketHash = XXH3_64bits(BucketBytes.data() + sizeof(MachineBucketData), 2 + SerializedConfig.size());
+    uint64_t ProcessBucketHash = XXH3_64bits(BucketBytes.data() + sizeof(MachineBucketData), 3 + SerializedConfig.size());
     BucketHash.high64 = MachineBucketHash;
     BucketHash.low64 = ProcessBucketHash;
 
diff --git a/FEXCore/Source/Interface/Core/DiskCache.h b/FEXCore/Source/Interface/Core/DiskCache.h
index ab0264d..0b43365 100644
--- a/FEXCore/Source/Interface/Core/DiskCache.h
+++ b/FEXCore/Source/Interface/Core/DiskCache.h
@@ -249,7 +249,7 @@ namespace DiskCache {
   // The current version of the diskcache.
   // This must be changed any time codegen changes occur!
   // Be aware of the impact of changing this frequently!
-  static constexpr uint16_t FormatVersion = 30;
+  static constexpr uint16_t FormatVersion = 31;
 
   static constexpr uint32_t LOOKUP_KEY_MAX_BUCKET_DEPTH = 500;
 
