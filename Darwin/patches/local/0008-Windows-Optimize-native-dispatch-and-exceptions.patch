+      }
+      if (Dst != 31) X[Dst] = Word ? static_cast<uint32_t>(Value) : Value;
+    }
+  }
+  if (Writeback) X[Rn] = WritebackAddress;
+  if (Acquire) std::atomic_thread_fence(std::memory_order_acquire);
+  return true;
+}
